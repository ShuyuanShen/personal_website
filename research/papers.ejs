```{=html}

<div class="paper-list">
  <% for (const item of items) { %>
    <article class="paper-card" <%= metadataAttrs(item) %>>
      <div class="paper-year"><%= item.year || 'Ongoing' %></div>
      <div class="paper-body">
        <h3><%= item.title %></h3>
        <p class="paper-authors"><%= item.author %></p>
        <% if (item.journal) { %>
          <p class="paper-venue"><em><%= item.journal %></em></p>
        <% } %>
        <div class="paper-links">
          <% if (item.pubopen) { %>
            <a href="<%= item.pubopen %>">Open access <span aria-hidden="true">↗</span></a>
          <% } %>
          <% if (item.pubclosed) { %>
            <a href="<%= item.pubclosed %>">Publisher <span aria-hidden="true">↗</span></a>
          <% } %>
          <% if (item.preprint) { %>
            <a href="<%= item.preprint %>">Paper <span aria-hidden="true">↗</span></a>
          <% } %>
          <% if (item.pdf) { %>
            <a href="<%= item.pdf %>">PDF <span aria-hidden="true">↗</span></a>
          <% } %>
        </div>
      </div>
    </article>
  <% } %>
</div>

```
